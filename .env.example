# คัดลอกเป็น .env (ไม่ commit) แล้วใส่ค่า — ไฟล์นี้ไม่มีค่าจริง
# ใช้ร่วมกัน: docker compose (อ่าน .env เอง), แอปใน profile dev (spring.config.import), scripts/db-apply.sh (source เอง)
# สร้างรหัส / กุญแจ: openssl rand -base64 32

# ---------- compose (dev เท่านั้น) ----------
DB_SUPERUSER_PASSWORD=
# admin ที่จำลอง server admin ของ Azure (NOSUPERUSER CREATEDB CREATEROLE BYPASSRLS) — ใช้รัน db/roles.sql
DB_ADMIN_USER=azure_admin
DB_ADMIN_PASSWORD=
DB_NAME=an22

# ---------- แอป ----------
# ผ่าน PgBouncer (Azure: port 6432 ของ server เดียวกัน) — ห้ามเป็น host:port เดียวกับ DB_MIGRATE_URL
DB_URL=jdbc:postgresql://localhost:6432/an22
# ตรงเข้า PostgreSQL (port 5432) — Flyway migrate เท่านั้น
DB_MIGRATE_URL=jdbc:postgresql://localhost:5432/an22
# prod (Azure บังคับ TLS):
#   DB_URL=jdbc:postgresql://<server>.postgres.database.azure.com:6432/an22?sslmode=verify-full&sslrootcert=<ไฟล์ CA ของ Azure>
#   DB_MIGRATE_URL=jdbc:postgresql://<server>.postgres.database.azure.com:5432/an22?sslmode=verify-full&sslrootcert=<ไฟล์ CA ของ Azure>
DB_APP_USER=an22_app
DB_APP_PASSWORD=
DB_PLATFORM_USER=an22_platform
DB_PLATFORM_PASSWORD=
DB_OWNER_USER=an22_owner
# ไม่ต้องตั้งเมื่อ FLYWAY_MIGRATE=false (ทางที่ 2 — DBA รัน scripts/db-apply.sh เอง)
DB_OWNER_PASSWORD=
# connection ต่อ DataSource ต่อ instance (ต่อ PgBouncer)
DB_POOL_SIZE=10
# true = migrate ตอน start, false = validate อย่างเดียว (ผ่าน PgBouncer ด้วย an22_app)
FLYWAY_MIGRATE=true

# กุญแจข้อมูลส่วนบุคคล — ไม่ตั้ง = ไม่ start; ทุก instance ชุดเดียวกัน; สำรองแยกจาก backup ของ DB (หาย = ข้อมูลผู้ซื้อหาย)
# PII_KEYS=<version 1-255>:<base64 32 byte>,… (เขียนด้วย version สูงสุด, อ่านได้ทุกตัว)
PII_KEYS=
# HMAC ไว้ค้นเลขผู้เสียภาษี (base64 ≥ 32 byte)
PII_HASH_KEY=

# JWT (HS256) — <kid>:<base64 ≥ 32 byte>,… : เซ็นด้วย kid สูงสุด ตรวจได้ทุกตัว
#   kid = ตัวเลข 1–9999; หมุน: เพิ่ม kid ใหม่ที่มากกว่า (ทุก instance) → token เดิมยังใช้ได้ → ลบ kid เก่าหลัง JWT_TTL_DAYS
JWT_SECRET=
JWT_TTL_DAYS=7

# URL ของหน้าเว็บ (an22-web) สำหรับลิงก์ในอีเมล (ตั้งรหัสผ่านใหม่) — ไม่ใช้ header Host
APP_BASE_URL=http://localhost:4200
# job ตามเวลา (ออกใบแจ้งหนี้ / ระงับค้างชำระ / ล้างของหมดอายุ) — ทุก instance เปิดได้ (ทำงานจริงตัวเดียวด้วยล็อกใน DB)
JOBS_ENABLED=true

# log ต่อ request: off | error (ค่าเริ่ม — body เฉพาะ 4xx / 5xx) | all
LOG_BODY=error
LOG_BODY_MAX=4096

# ---------- scripts/db-apply.sh ----------
# admin (Azure: server admin) ต่อ database postgres — libpq URI ไม่ใส่ user / รหัส
DB_ADMIN_URL=postgresql://localhost:5432/postgres
# prod: postgresql://<server>.postgres.database.azure.com:5432/postgres?sslmode=verify-full&sslrootcert=…
